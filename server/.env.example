NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/memora_db
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder
FIRECRAWL_API_KEY=fc-placeholder
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini

# Memory Provider Configuration (mem0_cloud | self_hosted)
MEMORY_PROVIDER=mem0_cloud
MEM0_API_KEY=m0-your-api-key-here

# Graph Database (Neo4j) Configuration (self_hosted | neo4j_aura)
GRAPH_PROVIDER=self_hosted
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memora_graph_password

# Runtime Self-Evaluation & Reflection Loop
EVAL_MAX_RETRIES=3
EVAL_CONFIDENCE_THRESHOLD=0.85
